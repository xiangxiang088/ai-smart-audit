# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ai_audit

# JWT密钥（自己生成一个随机字符串，越复杂越好，不要使用示例值）
JWT_SECRET=replace_with_a_long_random_string_generated_locally

# 端口
PORT=3003

# 运行环境标记。
# 注意：它决定 server.js 加载哪个环境文件（production → .env.production / development → .env.development / 未设置 → .env），
# 若用 PM2 或 systemd 启动，请通过启动参数传入该变量，而不是只写在文件里。
NODE_ENV=development

# 反向代理信任范围（决定 req.ip 是真实客户端 IP 还是代理 IP）。
#   loopback = Nginx 与 Node 同机部署（默认值，不配也行）
#   若 Nginx 与 Node 不同机，写代理 IP 或网段，如 192.168.1.10,10.0.0.0/8
TRUST_PROXY=loopback

# CORS 白名单（跨域前端才需要；同源请求服务端会自动放行，通常留空即可）
# 前端调用后端用的是相对路径 /api，与后端同源 —— 换域名、换 IP、上 HTTPS、走 Nginx 反代都不需要改这里。
# 仅「前后端分离部署」（前端 A 域名、API B 域名）时需要登记前端来源，支持逗号分隔与 *.example.com 通配子域：
#   ALLOWED_ORIGINS=https://audit.example.com,https://*.example.com
# 写 * 表示放行全部来源（仅限内网自用，公网暴露时不要这么配）。
ALLOWED_ORIGINS=http://localhost:3003,http://127.0.0.1:3003
# ============================================================
# 工程审计模块（v1.2.x）
# ============================================================

# PaddleOCR-VL 官方在线 API（AI Studio）——审计资料的“眼睛”
# Token 获取：https://aistudio.baidu.com/account/accessToken
OCR_KEY=your_aistudio_access_token
OCR_BASE_URL=https://paddleocr.aistudio-app.com
OCR_API_VERSION=v2
OCR_MODEL=PaddleOCR-VL-1.6
OCR_POLL_INTERVAL_MS=3000
OCR_TIMEOUT_MS=600000

# 火山方舟 Seed-2.1-pro（doubao-seed-evolving）——审计 Agent 大脑
# （规划/工具调用取证/跨文件核验/溯源问答/疑点判断/台账结论）
# 创建接入点后填入：https://console.volcengine.com/ark
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-evolving