# ============================================================
# 生产环境变量模板
# ------------------------------------------------------------
# 用法：
#   cp .env.production.example .env.production
#   然后按实际情况填写，重启服务生效。
#
# 重要：.env / .env.development / .env.production 都在 .gitignore 里，
#       **不会随代码一起部署**，服务器上必须手动创建，否则所有配置都是空的。
#       （dotenv 读不到文件时是静默的，只会在启动日志里看到一行「环境变量文件缺失」告警。）
# ============================================================

# 运行环境：生产环境务必设为 production
# server.js 依据它决定加载 .env.production / .env.development / .env
# 注意：PM2 用 --env production 或 Environment=NODE_ENV=production（systemd）传入，
#       只写在这个文件里是没用的 —— 读哪个文件本身就取决于它。
NODE_ENV=production

# 服务端口（Nginx 反代到这里）
PORT=3003

# 反向代理信任范围（决定 req.ip 是真实客户端 IP 还是代理 IP）
#   loopback  = Nginx 与 Node 同机部署（默认，最常见）
#   linklocal = 同机 + 内网链路本地地址
#   也可直接写代理 IP 或网段，多个用逗号分隔，如 192.168.1.10,10.0.0.0/8
# 配错的后果：所有请求的 req.ip 都变成代理 IP —— 登录限流被全站共享（10 次/分钟）、
#            操作日志里的 IP 全部失真。
TRUST_PROXY=loopback

# 数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ai_audit

# JWT 密钥：务必替换为随机长字符串，且不要与开发环境相同
# 生成方式：openssl rand -hex 32
JWT_SECRET=

# ------------------------------------------------------------
# CORS 白名单（跨域前端才需要，通常留空）
# ------------------------------------------------------------
# 本系统的前端调用后端用的是相对路径（/api），与后端**同源**，
# 服务端已对同源请求自动放行 —— 换域名、换 IP、上 HTTPS、走 Nginx 反代都不需要改这里。
#
# 只有「前后端分离部署」（前端在 A 域名，API 在 B 域名）时才需要登记前端来源：
#   ALLOWED_ORIGINS=https://audit.example.com
# 支持逗号分隔多个，也支持通配子域：
#   ALLOWED_ORIGINS=https://a.example.com,https://*.example.com
# 写 * 表示放行全部来源（仅限内网/自用，公网暴露时不要这么配）。
#
# 留空 = 只允许同源请求。
ALLOWED_ORIGINS=

# ============================================================
# 审计资料解析（“眼睛”）
# ============================================================
# PaddleOCR-VL 官方在线 API（AI Studio）
# Token 获取：https://aistudio.baidu.com/account/accessToken
OCR_KEY=
OCR_BASE_URL=https://paddleocr.aistudio-app.com
OCR_API_VERSION=v2
OCR_MODEL=PaddleOCR-VL-1.6
OCR_POLL_INTERVAL_MS=3000
OCR_TIMEOUT_MS=600000

# ============================================================
# 审计 Agent 大脑
# ============================================================
# 火山方舟 Seed-2.1-pro（doubao-seed-evolving）
# 创建接入点后填入：https://console.volcengine.com/ark
# 说明：模型链（主模型 / 备用 / 各自的超时）已迁移到数据库统一配置中心
#      （sl_sys_config，namespace=audit.ai，key=model_chain），可在
#      「🤖 模型配置」页面可视化调整；这里的 ARK_* 仅作为兜底默认值。
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-evolving
